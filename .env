APP_NAME=Fantom
DEBUG=True
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1

SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgesight_user
DB_PASSWORD=forgesight_password
DB_NAME=forgesight_db
DATABASE_URL=postgresql://forgesight_user:forgesight_password@localhost:5432/forgesight_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HF_TOKEN=your_huggingface_token_here

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=forgesight-analysis

MODEL_REGISTRY_PATH=./ml_models/registry
MLFLOW_TRACKING_URI=http://localhost:5000

DEFECT_CONFIDENCE_THRESHOLD=0.85
BOTTLENECK_UTILIZATION_THRESHOLD=0.85
DEFAULT_CURRENCY=USD

DATASET_RAW_DIR=./data/raw
DATASET_PROCESSED_DIR=./data/processed

STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=forgesight-datasets

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_ANALYTICS=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1