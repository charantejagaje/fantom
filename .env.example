# Fantom deployment configuration
# Copy to .env and fill real values:  cp .env.example .env
# NEVER commit .env (it is gitignored). This file documents every variable.

# ---- Application ----
APP_NAME=Fantom Industrial Decision Support API
ENVIRONMENT=development            # development | production
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# ---- Database (PostgreSQL in Docker; SQLite fallback for local dev) ----
# Local dev without Docker: leave DB_ENGINE=sqlite (no server needed).
# In compose, DB_* below configure the postgres service.
DB_ENGINE=sqlite
DB_HOST=db
DB_PORT=5432
DB_USER=fantom_user
DB_PASSWORD=change_this_db_password
DB_NAME=fantom_db

# ---- Data locations (host paths are mounted read-only into containers) ----
DATASET_RAW_DIR=./data/raw
DATASET_PROCESSED_DIR=./data/processed
ML_MODELS_DIR=./ml/saved_models

# ---- Authentication / RBAC ----
# REQUIRED in production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=720
REQUIRE_EMAIL_VERIFICATION=true
# Comma-separated invite codes allowing ENGINEER self-registration.
# Leave empty to disable engineer self-registration (owners invite via UI).
# OWNER accounts can NEVER be self-registered - only assigned by an owner.
ENGINEER_INVITE_CODES=

# ---- Email (verification / password reset) ----
# Development: leave SMTP_HOST empty -> emails written to data/outbox/*.eml,
# or set SMTP_HOST=mailpit SMTP_PORT=1025 to use the bundled Mailpit (UI :8025).
# Production: real SMTP/provider values (never committed).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fantom@localhost
SMTP_TLS=false
# Public base URL used in verification/reset links
APP_PUBLIC_URL=http://localhost:8080

# ---- Frontend AI-Studio server (frontend/server.ts, dev only) ----
# GEMINI_API_KEY enables server-side Gemini defect analysis in the studio UI.
# Leave EMPTY for offline demo mode: the /api/analyze-defect endpoint then returns
# its static knowledge-base fallback, and the UI must label it as demo output.
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# ---- Deployment ----
FRONTEND_PORT=8080

# ---- Future integrations (placeholders only; never commit real keys) ----
# SECRET_KEY=generate_with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# OPENAI_API_KEY=
# GEMINI_API_KEY=
