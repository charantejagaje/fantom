# Frontend environment (root .env is NOT read by Vite - this file is)
# Copy to frontend/.env for local overrides. Never commit frontend/.env.

# --- Vite (import.meta.env) ---
# Leave EMPTY/UNSET for same-origin API calls: the vite dev server proxies
# /api/v1 -> http://localhost:8100 (see vite.config.ts, override with
# PLATFORM_PROXY_TARGET), and nginx proxies /api -> backend:8000 in Docker.
# Only set a full URL for a cross-origin deployment, e.g.:
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- server.ts (npm run dev) ---
# dotenv loads frontend/.env (this file) because the dev server runs in frontend/.
# GEMINI_API_KEY enables server-side Gemini defect analysis in the studio UI.
# Leave EMPTY for offline demo mode: /api/analyze-defect then returns its static
# knowledge-base fallback, which the UI must label as demo output.
GEMINI_API_KEY=
APP_URL=http://localhost:3000
